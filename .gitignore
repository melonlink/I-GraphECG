# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# Data: raw datasets are not redistributed (see data/README.md); the processed cache is regenerable
/data/*
!/data/README.md

# Run logs
/outputs/logs/

# The manuscript is not part of the public archive. A checkout that carries the submission
# package as paper/ beside the code runs the manuscript tests (tests/test_manuscript_numbers.py,
# tests/test_figures_match_manuscript.py); without it they skip.
/paper/

# Assistant instructions for the local working copy
/CLAUDE.md

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# By-products of the documented commands that the lock does not register
/outputs/figures/
/outputs/runs/*/figures/

# By-products of the atrial-window control (scripts/stats/W1P_pwindow_control.py summarizes them;
# only that summary is registered, like the teacher-free encoders of W1O)
/outputs/runs/v1fix_pwin*/
/outputs/checkpoints/*pwin*

